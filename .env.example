# Example environment for the F&S app.
#
# Under docker-compose these two values are overridden with the in-cluster
# service names (see docker-compose.yml). Use them here when running the app
# directly against a local Postgres + Ollama (the venv path).

# Postgres DSN. Overrides db.dsn in config/settings.yaml.
FS_DSN=postgresql://fiffia:fiffia@localhost:5999/fiffia_fs

# Ollama base URL. Overrides ollama.base_url in config/settings.yaml.
FS_OLLAMA_URL=http://localhost:11434

# Optional overrides for the model pre-pull script
# (docker/ollama_init.sh):
# FS_EMBED_MODEL=nomic-embed-text
# FS_LLM_MODEL=qwen2.5:32b-instruct
